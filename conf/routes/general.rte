{
	"auth/login" : {
		"allows": "POST",
		"target": {
			"app": "auth",
			"act": "login"
		}
	},
	"auth/logout" : {
		"allows": "POST",
		"target": {
			"app": "auth",
			"act": "logout"
		}
	},
	"dev" : {
		"config": "service.ini",
		"target": {
			"app": "shows",
			"act": "edit"
		}
	},
	"index" : {
		"setup": "service",
		"output": "AJAX",
		"target": {
			"app": "shows",
			"act": "index"
		}
	}
}