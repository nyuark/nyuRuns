{
	"index" : {
		"target": {
			"pge": "home.html"
		}
	},
	"login" : {
		"target": {
			"pge": "login.html"
		}
	},
	"assets/*" : {
		"target": {
			"dir": "assets"
		}
	},
	"auth/login" : {
		"allows": "POST",
		"target": {
			"app": "auth",
			"act": "login"
		}
	},
	"auth/logout" : {
		"allows": "POST",
		"target": {
			"app": "auth",
			"act": "logout"
		}
	},
	"auth/activate" : {
		"allows": "POST",
		"target": {
			"app": "auth",
			"act": "activate"
		}
	},
	"auth/signup" : {
		"allows": "POST",
		"target": {
			"app": "auth",
			"act": "signup"
		}
	},
	"auth/forgot" : {
		"allows": "POST",
		"target": {
			"app": "auth",
			"act": "forgot"
		}
	},
	"auth/recovr" : {
		"allows": "POST",
		"target": {
			"app": "auth",
			"act": "recovr"
		}
	},
	"auth/password" : {
		"allows": "POST",
		"target": {
			"app": "auth",
			"act": "password"
		}
	},
	"auth/langs" : {
		"allows": "POST",
		"target": {
			"app": "auth",
			"act": "langs"
		}
	}
}
