{
	"plugin": { "authby": [], "sessby": [] },
	"login":  { "authby": "native", "authcf": "native", "sessby": "jtoken", "sesscf": "dftokn" },
	"dfpass": { "htpasswd": "conf/.htpasswd" },
	"native": { "basnme": "nyuRuns", "tblnme": "users", "idletm": 300, "maxtry": 5, "holdtm": 600, "minlen": 10 },
	"usrlst": { "usrfle": "conf/users.lst" },
	"limits": { "maxtry": 10, "holdtm": 600, "folder": "temp/limits" },
	"dfkeys": { "header": "X-Api-Key", "keylst": ["env:NYU_API_KEY"] },
	"dfbear": { "header": "Authorization", "scheme": "Bearer" },
	"dftokn": { "secret": "env:NYU_JWT_SECRET", "lifetm": 3600, "algrtm": "HS256" },
	"dfsess": { "cookie": "nyuSessn", "lifetm": 3600, "samest": "strict", "secure": true },
	"dfcert": { "chkvar": "SSL_CLIENT_VERIFY", "usrvar": "SSL_CLIENT_S_DN_CN", "issuer": "" }
}
