{
	"plugLibs": { "authWith": [], "carrWith": [] },
	"loginSet": { "authWith": "userFile", "authConf": "userFile", "carrWith": "jwtToken", "carrConf": "jwtToken" },
	"htpasswd": { "passFile": "conf/.htpasswd", "maxTries": 5, "holdSecs": 600 },
	"nativeDb": { "linkName": "nyuRuns", "useTable": "users", "idleSecs": 300, "maxTries": 5, "holdSecs": 600, "minChars": 10, "tfaCrypt": "env:NYU_TFA_KEY", "mailAcnt": "", "signupOn": false, "codeMins": 15, "linkTmpl": "" },
	"userFile": { "listFile": "conf/users.lst", "tfaCrypt": "env:NYU_TFA_KEY", "maxTries": 5, "holdSecs": 600 },
	"tryLimit": { "maxTries": 10, "holdSecs": 600, "dataPath": "temp/limits", "maxQueue": 256, "maxPerIp": 16, "alertsAt": [128, 200, 256], "markSecr": "env:NYU_MARK_KEY", "markDays": 90 },
	"regdKeys": { "headName": "X-Api-Key", "keysList": ["env:NYU_API_KEY"] },
	"jwtToken": { "hmacSecr": "env:NYU_JWT_SECRET", "lifeSecs": 3600, "signAlgo": "RS256", "privFile": "conf/keys/jwtToken.key", "publFile": "conf/keys/jwtToken.pub", "prevFile": "", "issuerId": "", "audience": [] },
	"phpSessn": { "cookName": "nyuSessn", "lifeSecs": 3600, "fullSecs": 43200, "sameSite": "strict", "secureOn": true, "dataPath": "" },
	"clntCert": { "checkVar": "SSL_CLIENT_VERIFY", "ownerVar": "SSL_CLIENT_S_DN_CN", "issueVar": "SSL_CLIENT_I_DN_CN", "issuerId": "" }
}
