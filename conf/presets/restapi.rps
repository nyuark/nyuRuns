{
	"presetId": "restapi",
	"synopsis": "Preset for a web API: Bearer tokens, with the login action left open",
	"settings": {
		"confType": "all",
		"confList": "any"
	},
	"security": { "required": true, "carrWith": "jwtToken", "carrConf": "jwtToken", "openList": ["auth/login", "auth/active", "auth/signup", "auth/forgot", "auth/recover", "/.well-known/jwks.json"], "minRoles": { "users/*": "managers" } },
	"inputSet": [
		{
			"sourceId": "QUERY",
			"readFrom": "QUERY",
			"fieldSet": "all"
		}
	],
	"dispatch": {
		"detectBy": "autopath",
		"pathForm": "$appToRun/$doAction/$argument"
	},
	"response": {
		"outputAs": "jsonData",
		"headList": {
			"Access-Control-Allow-Origin":	"*",
			"Access-Control-Allow-Methods":	"GET, POST, PUT, PATCH, DELETE, OPTIONS",
			"Access-Control-Allow-Headers":	"Authorization, Content-Type, X-Api-Key",
			"Cache-Control":				"no-cache, no-store, max-age=0, must-revalidate",
			"Expires":						"Mon, 26 Jul 1997 05:00:00 GMT",
			"Pragma":						"no-cache"
		}
	}
}
