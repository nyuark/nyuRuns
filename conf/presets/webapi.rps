{
	"label": "webapi",
	"about": "Preset for a web API: Bearer tokens, with the login action left open",
	"setup": {
		"ftypes": "all",
		"fnames": "any"
	},
	"auths": { "needed": true, "sessby": "jtoken", "sesscf": "dftokn", "openrt": ["auth/login"] },
	"input": [
		{
			"naming": "QUERY",
			"source": "QUERY",
			"fields": "all"
		}
	],
	"route": {
		"detect": "autopath",
		"mapper": "$app/$action/$param"
	},
	"rnder": {
		"tmplte": "plain",
		"return": "json",
		"headrs": {
			"Access-Control-Allow-Origin":	"*",
			"Access-Control-Allow-Methods":	"GET, POST, PUT, PATCH, DELETE, OPTIONS",
			"Access-Control-Allow-Headers":	"Authorization, Content-Type, X-Api-Key",
			"Cache-Control":				"no-cache, no-store, max-age=0, must-revalidate",
			"Expires":						"Mon, 26 Jul 1997 05:00:00 GMT",
			"Pragma":						"no-cache"
		}
	}
}
