{
	"presetId": "statics",
	"synopsis": "Preset for a site of pages, files and redirections: open access, no inputs, its own route folder",
	"settings": {
		"confType": "all",
		"confList": "any"
	},
	"security": { "required": false, "isPublic": true },
	"dispatch": {
		"detectBy": "manually",
		"routeDir": "conf/routes/statics",
		"fileRoot": "pages",
		"runMount": { "auth": false }
	},
	"response": {
		"outputAs": "jsonData",
		"headList": {
			"Cache-Control":	"no-cache"
		}
	}
}
