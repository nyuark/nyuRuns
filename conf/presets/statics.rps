{
	"presetId": "statics",
	"describe": "Preset for a site of pages, files and redirections: open access, no inputs, its own route folder",
	"settings": {
		"fileType": "all",
		"fileName": "any"
	},
	"security": { "required": false, "isPublic": true },
	"routings": {
		"detectBy": "manually",
		"routeDir": "conf/routes/statics",
		"htmlRoot": "pages",
		"mountSet": { "auth": false }
	},
	"response": {
		"outputAs": "jsonData",
		"headList": {
			"Cache-Control":	"no-cache"
		}
	}
}
