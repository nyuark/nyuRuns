{
	"presetId": "restapis",
	"describe": "Preset for a web API: Bearer tokens, with the login action left open",
	"settings": {
		"fileType": "all",
		"fileName": "any"
	},
	"security": { "required": true, "sessWith": "jwtToken", "sessConf": "jwtToken", "openList": ["auth/openSess", "auth/activate", "auth/register", "auth/askReset", "auth/useReset", "/.well-known/jwks.json"], "rteRoles": { "users/*": "manage" } },
	"incoming": [
		{
			"nameFrom": "QUERY",
			"dataFrom": "QUERY",
			"fieldSet": "all"
		}
	],
	"routings": {
		"detectBy": "autopath",
		"pathForm": "$app/$action/$param"
	},
	"response": {
		"outputAs": "jsonData",
		"headList": {
			"Access-Control-Allow-Origin":	"*",
			"Access-Control-Allow-Methods":	"GET, POST, PUT, PATCH, DELETE, OPTIONS",
			"Access-Control-Allow-Headers":	"Authorization, Content-Type, X-Api-Key",
			"Cache-Control":				"no-cache, no-store, max-age=0, must-revalidate",
			"Expires":						"Mon, 26 Jul 1997 05:00:00 GMT",
			"Pragma":						"no-cache"
		}
	}
}
