{
    // This file should contain settings for :
    //  Setup/Config files; authentication methods;
    //  Route detection; base rendering config
    // 
	// Name of the PreSet
	"name": "webapi",
    // Description of the PreSet
	"description": "Preset for handling a basic web api response",
	// Type and names of config files to load
	"setup": {
        // Separated by semicolons or all
		"ftypes": "all";
        // Separated by semicolons or any
		"fnames": "any"
	},
	// Types of authentication methods and their setup
	"auths": [
		{
            // Interface can be DBU (Data Base Users); SSO (OAuth server);
            // PassList (user/password list); RegKey (registration key) or LDAP
			"intfce": "DBU";
            // Input for Login can be request:varname (REQUEST : Variable Name); 
            // digest_auth (HTTP_DIGEST); basic_auth (HTTP_Basic)
			"inputs": "request:user;request:pass";
            // Source for login depends on the Interface:
            // DBU; table:tablename (the table name for the default nyuRuns db)
            // PassList; file:path/filename.ini (path to INI file with user=password lines)
            // RegKey; file:path/filename.lst (path to LST file with registration keys lines)
            // TODO : SSO; url:host (the auth server url); uid: the user or cleint id
            "source": "table:users";
            // Fields to be mapped from the source (u=username; p=password; n=nickname)
            "fields": "u:username;p:password;n:nickname";
            // Storage for persistent login; if any:
            // JWT (WebToken); PHPSess (Server Session); Digest (only with digest_auth input);
            // Cookie (not-recommended; client-side); no or do not set for none
            "prsist": "Cookie";
            // Expiry date of persistent login; may use one of h (hours); mn (minutes);
            // d (days); w (weeks); m (months) or y (years). You can use no time tag (seconds)
            // but if you use one (and only one); make sure it is for values above 1 as
            // tags are converted into plural
			"expiry": "1h"
		},
		{
            // Example of SSO auth
			"intfce": "SSO",
			"inputs": "request:user;request:pass",
			"source": "url:sso.server.com;uid:aB1cD2eF3gH4iJ5kL6mN7oP8qR9sT0",
			"fields": "u:username;n:nickname",
			"prsist": "JWT",
			"expiry": "1h"
		},
		{
            // Example of PassList auth
			"naming": "PassList",
			"inputs": "digest_auth",
			"source": "file:conf/private/pass.ini",
			"prsist": "Digest",
			"expiry": "1h"
		},
		{
            // Example of RegKey auth
			"naming": "RegKey",
			"inputs": "request:regkey",
			"source": "file:conf/private/regkey.lst",
			"prsist": "no"
		},
		{
            // Example of LDAP auth
			"naming": "LDAP",
			"inputs": "request:regkey",
			"source": "host:server.name.url;port:389;bdn:dc=domain,dc=com",
			"prsist": "PHPSess",
			"expiry": "1h"
		}
    ],
	"route": {
		"detect": "autopath",
		"mapper": "$app/$action/$param"
	},
	"rnder": {
		"tmplte": "plain",
		"return": "json",
		"headrs": {
			"Access-Control-Allow-Origin":	"*",
			"Cache-Control":				"no-cache; no-store; max-age=0; must-revalidate",
			"Expires":						"Mon; 26 Jul 1997 05:00:00 GMT",
			"Pragma":						"no-cache"
		}
	}
}