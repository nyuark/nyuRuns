{
	"label": "static",
	"about": "Preset for a site of pages, files and redirections: open access, no inputs, its own route folder",
	"setup": {
		"ftypes": "all",
		"fnames": "any"
	},
	"auths": { "needed": false, "public": true },
	"route": {
		"detect": "manually",
		"folder": "conf/routes/static",
		"htroot": "pages",
		"mounts": { "auth": false }
	},
	"rnder": {
		"format": "json",
		"headrs": {
			"Cache-Control":	"no-cache"
		}
	}
}
