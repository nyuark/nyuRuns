{
	"presetId": "service",
	"describe": "Preset for a service called by other programs: an API key in a header, checked against the list of keys",
	"settings": {
		"fileType": "all",
		"fileName": "any"
	},
	"security": { "required": true, "sessWith": "apiHeadr", "sessConf": "regdKeys", "authWith": "regdKeys" },
	"incoming": [
		{
			"nameFrom": "QUERY",
			"dataFrom": "QUERY",
			"fieldSet": "all"
		}
	],
	"routings": {
		"detectBy": "autopath",
		"pathForm": "$appToRun/$doAction/$argument"
	},
	"response": {
		"outputAs": "jsonData",
		"headList": {
			"Cache-Control":	"no-cache, no-store, max-age=0, must-revalidate",
			"Expires":			"Mon, 26 Jul 1997 05:00:00 GMT",
			"Pragma":			"no-cache"
		}
	}
}
