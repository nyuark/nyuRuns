{
	"name": "webapi",
	"description": "Preset for handling a basic web api response",
	"setup": {
		"config": "all",
		"format": "all",
		"bypass": "any"
	},
	"auths": { "required": true, "sess": "Basic", "auth": "PassList", "confKey": "basic_default" },
	"input": [
		{
			"naming": "QUERY",
			"source": "REQUEST",
			"option": "ALL",
			"fields": "all",
			"format": "utf-8"
		},
		{
			"naming": "CACHE",
			"source": "FILE",
			"option": "cache/webapi.tmp",
			"fields": "all",
			"format": "utf-8"
		}
	],
	"route": {
		"detect": "autopath",
		"mapper": "$app/$action/$param"
	},
	"rnder": {
		"tmplte": "plain",
		"return": "json",
		"headrs": {
			"Access-Control-Allow-Origin":	"*",
			"Cache-Control":				"no-cache, no-store, max-age=0, must-revalidate",
			"Expires":						"Mon, 26 Jul 1997 05:00:00 GMT",
			"Pragma":						"no-cache"
		}
	}
}