{
	"presetId": "websites",
	"describe": "Preset for a site used from a browser: a session cookie, its users checked against the users table, the login left open, its own route folder",
	"settings": {
		"fileType": "all",
		"fileName": "any"
	},
	"security": { "required": true, "sessWith": "phpSessn", "sessConf": "phpSessn", "authWith": "nativeDb", "authConf": "nativeDb", "openList": ["auth/openSess", "auth/activate", "auth/register", "auth/askReset", "auth/useReset", "/login", "/assets/*"], "signRout": "/login", "rteRoles": { "users/*": "sysadmin" } },
	"incoming": [
		{
			"nameFrom": "QUERY",
			"dataFrom": "QUERY",
			"fieldSet": "all"
		}
	],
	"routings": {
		"detectBy": "autopath",
		"pathForm": "$app/$action/$param",
		"routeDir": "conf/routes/websites",
		"htmlRoot": "pages"
	},
	"response": {
		"outputAs": "jsonData",
		"headList": {
			"Cache-Control":	"no-cache, no-store, max-age=0, must-revalidate",
			"Expires":			"Mon, 26 Jul 1997 05:00:00 GMT",
			"Pragma":			"no-cache"
		}
	}
}
