{
	"label": "websit",
	"about": "Preset for a site used from a browser: a session cookie, its users checked against the users table, the login left open, its own route folder",
	"setup": {
		"ftypes": "all",
		"fnames": "any"
	},
	"auths": { "needed": true, "sessby": "phsess", "sesscf": "dfsess", "authby": "native", "authcf": "native", "openrt": ["auth/login", "auth/activate", "/login", "/assets/*"], "signin": "/login", "rolert": { "users/*": "manage" } },
	"input": [
		{
			"naming": "QUERY",
			"source": "QUERY",
			"fields": "all"
		}
	],
	"route": {
		"detect": "autopath",
		"mapper": "$app/$action/$param",
		"folder": "conf/routes/websit",
		"htroot": "pages"
	},
	"rnder": {
		"format": "json",
		"headrs": {
			"Cache-Control":	"no-cache, no-store, max-age=0, must-revalidate",
			"Expires":			"Mon, 26 Jul 1997 05:00:00 GMT",
			"Pragma":			"no-cache"
		}
	}
}
