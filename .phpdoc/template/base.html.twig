{% extends 'layout.html.twig' %}

{# Nothing is asked from another host: the fonts, the icons and the Prism styles are served from the site itself
   (fonts/ and libs/, copied by build.ps1). The text font is Cabin and the code font Source Code Pro, both in
   css/custom.css.twig; Open Sans is not asked for. The icons are the solid style of Font Awesome only. #}
{% block stylesheets %}
    <link rel="stylesheet" href="css/template.css">
    <link rel="stylesheet" href="libs/fontawesome/css/fontawesome.min.css">
    <link rel="stylesheet" href="libs/fontawesome/css/solid.min.css">
    <link rel="stylesheet" href="libs/prism/prism-okaidia.min.css">
    <link rel="stylesheet" href="libs/prism/prism-line-numbers.min.css">
    <link rel="stylesheet" href="libs/prism/prism-line-highlight.min.css">
{% endblock %}

{# Fuse runs the search; css-vars-ponyfill, only needed by Internet Explorer, is left out #}
{% block javascripts %}
    <script src="libs/fuse/fuse.js"></script>
    <script src="js/template.js"></script>
    <script src="js/search.js"></script>
    <script defer src="js/searchIndex.js"></script>
{% endblock %}
