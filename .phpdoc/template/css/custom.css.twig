{# The style of the nyuRuns drafts: black banner, orange #ff6600, Gill Sans (Cabin where it is not installed) #}

@font-face {
    font-family: 'Cabin';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('../fonts/Cabin.ttf') format('truetype');
}

@font-face {
    font-family: 'Cabin';
    font-style: italic;
    font-weight: 400 700;
    font-display: swap;
    src: url('../fonts/Cabin-Italic.ttf') format('truetype');
}

:root {
    --font-primary: 'Gill Sans', 'Gill Sans MT', 'Cabin', Helvetica, Arial, sans-serif;
    --font-secondary: 'Gill Sans', 'Gill Sans MT', 'Cabin', Helvetica, Arial, sans-serif;
    --letter-spacing--primary: .01rem;

    --primary-color-hue: 24;
    --primary-color-saturation: 100%;
    --primary-color: #ff6600;
    --text-color: #111;
    --title-text-color: #ff6600;
    --header-bg-color: #000;
}

/* Header: the frame of the drafts across the page, as on the pages of the documents (.phpdoc/site):
   4px of black, a 1px white line, 4px inside it; the logo on the left, the title after it */
.phpdocumentor-header.phpdocumentor-section {
    box-sizing: border-box;
    width: auto;
    max-width: none;
    margin: 4px;
    padding: 4px;
    background-color: var(--header-bg-color);
    border: 1px solid #fff;
    box-shadow: 0 0 0 4px var(--header-bg-color);
    align-items: center;
}

.phpdocumentor-title {
    width: auto;
    border-right: none;
}

.phpdocumentor-title__link.nyu-frame,
.phpdocumentor-title__link.nyu-frame:hover {
    --logo-high: 4.5rem;
    display: flex;
    align-items: center;
    gap: 2.5rem;
    transform: none;
    font-weight: normal;
    line-height: 1.2;
    text-decoration: none;
}

.nyu-frame__logo {
    display: block;
    flex: 0 0 auto;
    height: var(--logo-high);
    width: auto;
}

/* The title lines up with the wordmark, whose middle is at 26% of the logo's height */
.nyu-frame__text {
    align-self: flex-start;
    margin-top: calc(var(--logo-high) * .26 - .6em);
    color: var(--title-text-color);
    font-family: var(--font-primary);
    font-size: 1.5rem;
    letter-spacing: 0;
    white-space: nowrap;
}

.nyu-frame__text em {
    font-style: italic;
    font-weight: 700;
}

/* A long default value (a list of names) wraps instead of widening the page */
.phpdocumentor-signature__default-value {
    overflow-wrap: anywhere;
}

@media (max-width: 800px) {
    .phpdocumentor-title__link.nyu-frame { --logo-high: 2.6rem; gap: 1rem; }
    .nyu-frame__text { font-size: .95rem; white-space: normal; }
}

.phpdocumentor-topnav__menu-item a,
.phpdocumentor-header .phpdocumentor-search__label,
.phpdocumentor-header .phpdocumentor-search__icon {
    color: #fff;
}

.phpdocumentor-topnav__menu-item a:hover {
    border-bottom-color: #fff;
}

/* Titles in the orange of the drafts */
.phpdocumentor h1,
.phpdocumentor h2,
.phpdocumentor-content__title {
    color: var(--primary-color);
    font-weight: normal;
}
