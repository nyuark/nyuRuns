/vendor/*
!/vendor/.htaccess
/logs/*
/temp/*
!/temp/.htaccess
*.php_cs.cache
/.phpunit.result.cache
# Local credentials: never commit
/.env
/conf/access.json
/conf/database.json
/conf/mailer.json
/conf/.htpasswd
/conf/users.lst
# The presets each server serves, and where: made by php nyuRun install complete
/conf/doorways.lst
# Keys signing the tokens: the private one never leaves the server
/conf/keys/
# Bundles made for the environments (php nyuRun bundling)
/dist/
# The documentation site and the code reference, made by pwsh .phpdoc/build.ps1
/docs/online/
