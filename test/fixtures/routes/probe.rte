{
	"ping" :                  { "pointsTo": { "appNamed": "probe", "actNamed": "sanitize" } },
	"items/$id" :             { "pointsTo": { "appNamed": "probe", "actNamed": "mirrored" } },
	"items/$id/parts/$part" : { "pointsTo": { "appNamed": "probe", "actNamed": "mirrored" } },
	"probe/warnfail" :        { "pointsTo": { "appNamed": "probe", "actNamed": "sanitize" } },
	"plain" :                 { "pointsTo": { "appNamed": "probe", "actNamed": "txtProbe" } },
	"broken" :                { "mthdList": "GET" },
	"gets" :                  { "mthdList": "head, options", "pointsTo": { "appNamed": "probe", "actNamed": "sanitize" } },
	"both" :                  { "mthdList": "GET, POST", "pointsTo": { "appNamed": "probe", "actNamed": "sanitize" } },
	"things/$id" :            { "pointsTo": {
		"GET":    { "appNamed": "probe", "actNamed": "mirrored" },
		"delete": { "appNamed": "probe", "actNamed": "sanitize" }
	} },
	"old/$id" :               { "pointsTo": { "redirect": "/items/$id", "httpCode": 301 } },
	"away" :                  { "pointsTo": { "redirect": "https://example.org/docs" } },
	"resend" :                { "mthdList": "POST", "pointsTo": { "redirect": "/both", "httpCode": 307 } },
	"badcode" :               { "pointsTo": { "redirect": "/ping", "httpCode": 200 } },
	"badaddr" :               { "pointsTo": { "redirect": "//example.org/" } },
	"style" :                 { "pointsTo": { "filePath": "site.css" } },
	"nofile" :                { "pointsTo": { "filePath": "missing.css" } },
	"secret" :                { "pointsTo": { "filePath": "../letters.txt" } },
	"docs/*" :                { "pointsTo": { "foldPath": "docs" } },
	"hello/$id" :             { "pointsTo": { "pageFile": "hello.html" } },
	"notpage" :               { "pointsTo": { "pageFile": "site.css" } },
	"enter" :                 { "pointsTo": {
		"GET":  { "pageFile": "hello.html" },
		"POST": { "appNamed": "probe", "actNamed": "sanitize" }
	} }
}
