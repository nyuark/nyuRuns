# Every path goes to index.php, which reads the route from REQUEST_URI:
# a file left in www by mistake is never served, nor run.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/index\.php$
    RewriteRule ^ index.php [L]
</IfModule>
<IfModule !mod_rewrite.c>
    FallbackResource /index.php
</IfModule>
Options -Indexes
# The rest of the project is denied (see the .htaccess at its root): www is served
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
# Upload progress off (CVE-2026-115560), with mod_php; with PHP-FPM, see HOSTING.md
<IfModule mod_php.c>
    php_flag session.upload_progress.enabled off
</IfModule>