<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Code reference of nyuRuns, generated from the docblocks of src.
    Run from the project root, with a PHP that loads mbstring:
        php -d memory_limit=1G temp/tools/phpDocumentor.phar run
    On Windows, pwsh .phpdoc/build.ps1 does it, and adds the banner and the fonts.
    The output (docs/site/reference) and the cache (temp/docs/cache) are not tracked.
-->
<phpdocumentor
    configVersion="3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://www.phpdoc.org"
    xsi:noNamespaceSchemaLocation="https://docs.phpdoc.org/latest/phpdoc.xsd"
>
    <title>nyuRuns – Code Reference</title>
    <paths>
        <output>docs/site/reference</output>
        <cache>temp/docs/cache</cache>
    </paths>
    <version number="1.0">
        <api>
            <source dsn=".">
                <path>src</path>
            </source>
            <visibility>public</visibility>
            <visibility>protected</visibility>
            <default-package-name>nyuRuns</default-package-name>
        </api>
    </version>
    <setting name="graphs.enabled" value="false"/>
</phpdocumentor>
