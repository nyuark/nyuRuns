# Copy to .env and fill in. Never commit .env
# A config value written env:NAME (see conf/access.json) is replaced by the value of NAME

# Secret signing the JWT tokens with HS256: at least 32 characters. With RS256, the default,
# the tokens are signed by the keys of conf/keys and this stays empty
NYU_JWT_SECRET=
# API key accepted by the dfkeys block
NYU_API_KEY=
# Key the 2FA secrets are stored encrypted with: at least 32 characters. Empty: they are stored readable
NYU_TFA_KEY=
# Key the login marks are signed with (limits.mrkkey; php nyuRun settings makeSecr mrkkey)
NYU_MARK_KEY=
# Password of the database user (conf/database.json)
NYU_DB_PASS=
# Password of the mail account (conf/mailer.json); one name per account that needs one
NYU_MAIL_PASS=

# Optional test servers (test/data/MySQLTest.php): a test skips itself when its
# server is not configured or does not answer. Without a USER, the account of
# conf/database.json is used when it is of the same type. The tests work in
# their own database (default nyuruns_test; the name must contain "test").
NYU_TEST_MYSQL_HOST=
NYU_TEST_MYSQL_PORT=
NYU_TEST_MYSQL_BASE=
NYU_TEST_MYSQL_USER=
NYU_TEST_MYSQL_PASS=
NYU_TEST_PGSQL_HOST=
NYU_TEST_PGSQL_PORT=
NYU_TEST_PGSQL_BASE=
NYU_TEST_PGSQL_USER=
NYU_TEST_PGSQL_PASS=
# MongoDB (test/data/MongoDBTest.php): a local server asking for no account is
# tried on 127.0.0.1:27017 even when nothing is filled here
NYU_TEST_MONGO_HOST=
NYU_TEST_MONGO_PORT=
NYU_TEST_MONGO_BASE=
NYU_TEST_MONGO_USER=
NYU_TEST_MONGO_PASS=

# Full path of the ffmpeg program (conf/system.ini), empty when there is none
NYU_SND_TOOL=
